{
  "name": "zaotai-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "npm run content:build && vitest run",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/build-content.mjs --validate",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "recipe:new": "node scripts/new-recipe.mjs",
    "upstream:update": "node scripts/import-upstream.mjs",
    "search:benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write src scripts tests vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "minisearch": "^7.2.0",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "3.6.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
