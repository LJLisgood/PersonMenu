{
  "name": "zaotai-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "npm run cloud:prepare && vitest run",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/build-content.mjs --validate",
    "build": "npm run content:build && npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "recipe:new": "node scripts/new-recipe.mjs",
    "upstream:update": "node scripts/import-upstream.mjs",
    "search:benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write src scripts tests vite.config.ts",
    "check": "tsc -b && tsc -p tsconfig.server.json",
    "build:cloud": "npm run build && node scripts/cloud-build.mjs",
    "dev:cloud": "wrangler dev --port 8788",
    "deploy:cloud": "npm run build:cloud && wrangler deploy",
    "cloud:prepare": "node scripts/cloud-content.mjs prepare",
    "cloud:import": "node --env-file-if-exists=.dev.vars scripts/cloud-content.mjs import",
    "cloud:export": "node --env-file-if-exists=.dev.vars scripts/cloud-content.mjs export",
    "test:cloud": "npm run cloud:prepare && vitest run tests/cloud-*"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@electric-sql/pglite": "0.5.9",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "gray-matter": "^4.0.3",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "sharp": "^0.34.4",
    "supabase": "2.120.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "4.151.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
